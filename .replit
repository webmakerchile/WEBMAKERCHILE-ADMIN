modules = ["nodejs-24", "postgresql-16", "python-3.11"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"
run = ["bash", "-c", "PORT=${PORT:-5000} node artifacts/api-server/dist/index.cjs"]
build = ["bash", "-c", "pnpm install && pnpm --filter @workspace/admin-panel run build && pnpm --filter @workspace/api-server run build"]

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend API"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Frontend"

[[workflows.workflow]]
name = "Backend API"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "PORT=3001 pnpm --filter @workspace/api-server run dev"
waitForPort = 3001

[[workflows.workflow]]
name = "Frontend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/admin-panel run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
stack = "BEST_EFFORT_FALLBACK"
expertMode = true
integrations = ["google-drive:1.0.0", "javascript_openai_ai_integrations:2.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
GOOGLE_CLIENT_ID = "341345751156-mvvqerb1ai56v61kpg5ctmq5khu8vvnq.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET = "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"
ALLOWED_ADMIN_EMAILS = "webmakerchile@gmail.com"
INSTAGRAM_APP_ID = "1494052229003058"
META_APP_ID = "1317067910325181"
INSTAGRAM_USER_ID = "17841467106955089"

[userenv.development]
PORT = "5000"
BASE_PATH = "/"
API_PORT = "3001"

[userenv.production]
GOOGLE_CALLBACK_URL = "https://admin.webmakerlatam.com/api/auth/google/callback"

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 5000
